# Copy this file to .env and fill in your own values. Never commit .env.

# Optional: MongoDB Atlas connection string. If empty/unreachable, HotelPro stores data in data/hotelpro-local-db.json
MONGODB_URI=

# Required for production: a random secret, at least 32 characters
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Admin login (used ONLY at /admin). Choose your own values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# WhatsApp button + chatbot support details (used by the website). Country code + number, digits only.
VITE_WHATSAPP_NUMBER=916263901274
VITE_SUPPORT_PHONE=+91 6263901274
VITE_SUPPORT_EMAIL=nidhithakre51@gmail.com
